<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\evals\engineering-impact\v1\fixtures\requirement-r123.json">
      <Link>evals\engineering-impact\v1\fixtures\requirement-r123.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\evals\engineering-impact\v1\fixtures\source-evidence\*.json">
      <Link>evals\engineering-impact\v1\fixtures\source-evidence\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\evals\prompt-evaluation\few-shot\v1\**\*">
      <Link>evals\prompt-evaluation\few-shot\v1\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lattice.AI.Runtime\Lattice.AI.Runtime.csproj" />
    <ProjectReference Include="..\Lattice.AI.Runtime.Azure\Lattice.AI.Runtime.Azure.csproj" />
    <ProjectReference Include="..\Lattice.AI.Runtime.Contracts\Lattice.AI.Runtime.Contracts.csproj" />
    <ProjectReference Include="..\Lattice.AI.Runtime.Evaluation\Lattice.AI.Runtime.Evaluation.csproj" />
    <ProjectReference Include="..\Orchestration.API\Orchestration.API.csproj" />
  </ItemGroup>
</Project>
